{
  "name": "monad-signal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsx src/demo/run.ts",
    "setup:monad-wallet": "tsx src/demo/setup-monad-wallet.ts",
    "demo:monad": "tsx src/demo/run-monad-live.ts",
    "demo:present": "tsx src/demo/run-monad-presenter.ts",
    "demo:present:three": "tsx src/demo/run-monad-three.ts",
    "demo:replay": "tsx src/demo/run-demo-replay.ts",
    "demo:web": "tsx src/web/server.ts",
    "demo:accept": "npm run typecheck && npm run lint && npm test && npm run build && npm run demo:replay && npm run demo:present:three"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "viem": "^2.55.8"
  }
}
